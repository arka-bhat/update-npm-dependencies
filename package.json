{
  "name": "update-npm-dependencies",
  "displayName": "Update Dependencies",
  "description": "A Visual Studio Code extension to selectively update npm, yarn, pnpm, or bun dependencies to their latest versions.",
  "publisher": "arka-bhattacharya",
  "icon": "assets/extension-icon.png",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.94.0"
  },
  "homepage": "https://github.com/arka-bhat/update-npm-dependencies",
  "repository": {
    "type": "git",
    "url": "https://github.com/arka-bhat/update-npm-dependencies"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "javascript",
    "node",
    "npm",
    "yarn",
    "pnpm",
    "bun",
    "mise",
    "update",
    "dependency"
  ],
  "activationEvents": [
    "workspaceContains:**/package.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "update-npm-dependencies.updateDependencies",
        "title": "Update Dependencies"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/semver": "^7.7.1",
    "@types/vscode": "^1.115.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.2.0",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.2",
    "webpack": "^5.106.0",
    "webpack-cli": "^7.0.2"
  },
  "dependencies": {
    "npm-check-updates": "^20.0.0"
  }
}